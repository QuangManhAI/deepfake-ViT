\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {DINOv3 ViT-S/16 (Plus).} (a) Full pipeline: the image is split into $16\times 16$ patches, embedded to $384$ dimensions, prepended with a \texttt  {[CLS]} token and $4$ register tokens, and passed through $12$ transformer blocks; the final \texttt  {[CLS]} embedding is classified by a linear head. (b) One transformer block, with a gated (SwiGLU) MLP and residual connections around both sub-layers.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:vit_arch}{{1}{4}{\textbf {DINOv3 ViT-S/16 (Plus).} (a) Full pipeline: the image is split into $16\times 16$ patches, embedded to $384$ dimensions, prepended with a \texttt {[CLS]} token and $4$ register tokens, and passed through $12$ transformer blocks; the final \texttt {[CLS]} embedding is classified by a linear head. (b) One transformer block, with a gated (SwiGLU) MLP and residual connections around both sub-layers}{figure.caption.3}{}}
\newlabel{fig:cnn_pipe}{{2a}{5}{ConvNeXt pipeline}{figure.caption.4}{}}
\newlabel{sub@fig:cnn_pipe}{{a}{5}{ConvNeXt pipeline}{figure.caption.4}{}}
\newlabel{fig:cnn_block}{{2b}{5}{ConvNeXt block}{figure.caption.4}{}}
\newlabel{sub@fig:cnn_block}{{b}{5}{ConvNeXt block}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {DINOv3 ConvNeXt-Tiny.} (a) Full pipeline: a patchify stem followed by four stages with depths $[3,3,9,3]$ and widths $[96,192,384,768]$, separated by $2\times 2$ stride-$2$ downsampling layers, ending in global average pooling and a linear head. (b) One ConvNeXt block: a $7\times 7$ depthwise convolution, layer normalization, an inverted bottleneck ($1\times 1$, expand $4\times $, GELU, $1\times 1$), LayerScale, and a residual connection.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:cnn_arch}{{2}{5}{\textbf {DINOv3 ConvNeXt-Tiny.} (a) Full pipeline: a patchify stem followed by four stages with depths $[3,3,9,3]$ and widths $[96,192,384,768]$, separated by $2\times 2$ stride-$2$ downsampling layers, ending in global average pooling and a linear head. (b) One ConvNeXt block: a $7\times 7$ depthwise convolution, layer normalization, an inverted bottleneck ($1\times 1$, expand $4\times $, GELU, $1\times 1$), LayerScale, and a residual connection}{figure.caption.4}{}}
