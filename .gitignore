# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
*.mp4
*.json
*.jpeg
# Virtual environment
.venv/
venv/
env/
*.mov
*.avi
*.wav
*.dircksum
*.zip
*.log
*.csv

# Result/consolidated JSONs are tracked (results are repo artifacts)
!experiments/results/**/*.json
!outputs/eval/*.json
!data/splits/*.json

# Data (bulk raw data is ignored via media/archive patterns above)
data/processed/*
!data/processed/.gitkeep
data/raw/DF40/

# Experiments: run state + checkpoints/weights are not committed
experiments/runs/*
!experiments/runs/.gitkeep
experiments/checkpoints/*
!experiments/checkpoints/.gitkeep
experiments/checkpoints/weights/*
!experiments/checkpoints/weights/.gitkeep
experiments/results/features/

*.png
*.jpg 
# Model weights
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
models/*
!models/.gitkeep

# Heavy output artifacts
outputs/checkpoints/
outputs/features/
outputs/finetune/
outputs/attention/
outputs/.drafts/
outputs/.plans/


# Config secrets
.env

# Scratch and temporary scripts
scratch/
scratch/*

# Tool caches
.feynman/

# IDE / OS
.idea/
.vscode/
.DS_Store

